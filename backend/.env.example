## Environment
ENVIRONMENT="dev"
LOG_LEVEL="INFO"

BASE_URL="http://localhost:8000/"

## Redis (Upstash or self-hosted)
REDIS_HOST="your-redis-host"
REDIS_KEY="your-redis-key"
REDIS_PORT="6379"

## PostgreSQL (Supabase or self-hosted)
## Use Supabase's transaction-mode pooler port (6543), not session-mode (5432) —
## session mode has a very low max client limit and gets exhausted quickly by
## SSE connections and background tasks.
DB_HOST="your-db-host"
DB_PORT="6543"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="your-db-password"


# Workers
WORKER_ID = "1"