## Environment
ENVIRONMENT="dev"
LOG_LEVEL="INFO"

BASE_URL="http://localhost:8000/"

## Redis (Upstash or self-hosted)
REDIS_HOST="your-redis-host"
REDIS_KEY="your-redis-key"
REDIS_PORT="6379"

## PostgreSQL (Supabase or self-hosted)
DB_HOST="your-db-host"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="your-db-password"
